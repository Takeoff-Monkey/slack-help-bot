# Ignore Python bytecode and environment
__pycache__/
*.py[cod]
*.so
.venv/
.venv-ocr/
env/
*.egg-info/

# Ignore system files
.DS_Store

# Ignore secrets and credentials
.env
.envrc
.claude/settings.json
.claude/work-key.sh
g-sheets-experiments-c48bb50fa78e.json

# Per-tool / sandbox secrets and virtualenvs (explicit, even though the rules above
# already match these anywhere in the tree — defense in depth so a tool's .env is never
# pushed). Tool/sandbox source code itself stays tracked.
tools/**/.env
tools/**/.venv/
tools/**/__pycache__/
sandbox/.venv/
sandbox/.venv-ocr/
sandbox/**/__pycache__/

# AWS SAM build output (container Lambdas)
.aws-sam/

# Real customer worksheets used for local testing (may carry a client's name/email/phone).
# This repo is public — never commit one. Sample_test_sheets (a sibling directory outside the
# repo) is the established home for these; tools/arazoza-formatter/tests/samples/ is the
# equivalent for this tool, kept local-only by this rule.
tools/arazoza-formatter/tests/samples/

# Explicitly track these required files
!app.py
!Procfile
!requirements.txt
!.gitignore
